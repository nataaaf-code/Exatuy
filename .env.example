# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env — sudah dikecualikan di .gitignore.

MYSQL_ROOT_PASSWORD=ganti-dengan-password-root-yang-kuat
MYSQL_DATABASE=examora_db
MYSQL_USER=examora_app
MYSQL_PASSWORD=ganti-dengan-password-aplikasi-yang-kuat

# Kunci enkripsi API key pembayaran (AES-256). Wajib diisi, buat dengan: openssl rand -base64 32
# Jangan diganti setelah dipakai: API key yang sudah tersimpan tidak bisa dibaca dengan kunci lain.
EXATUY_ENCRYPTION_KEY=
# Hanya untuk pengembangan lokal: true = pakai kunci bawaan yang tertulis di source.
EXATUY_ALLOW_DEFAULT_KEY=false
